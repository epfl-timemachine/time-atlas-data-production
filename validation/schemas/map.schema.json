{
  "$id": "https://timeatlas.eu/rde/map.schema.json",
  "type": "object",
  "properties": {
    "uuid": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "rde_type": {
      "type": "string"
    },
    "name": {
      "$ref": "https://timeatlas.eu/rde/multilingual_data.schema.json"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://timeatlas.eu/rde/multilingual_data.schema.json"
      }
    },
    "metadata_field_config": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "display_label": {
            "$ref": "https://timeatlas.eu/rde/multilingual_data.schema.json"
          },
          "display_order": {
            "type": "number"
          }
        },
        "required": ["uuid", "id", "type", "display_label", "display_order"]
      }
    },
    "thumbnail": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "extent": {
        "type": "array",
        "items": {
            "type": "number"
        },
        "minItems": 4,
        "maxItems": 4
    },
    "contains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "falls_within": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "contains",
    "end_time",
    "falls_within",
    "name",
    "extent",
    "version",
    "thumbnail",
    "rde_type",
    "slug",
    "start_time",
    "uuid"
  ]
}