{
  "$id": "https://timeatlas.eu/rde/point_of_interest.schema.json",
  "type": "object",
  "properties": {
    "uuid": {
      "type": "string"
    },
    "rde_type": {
      "type": "string"
    },
    "represents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "height": {
      "type": "object",
      "building": {
        "type": {
          "type": "number"
        },
        "terrain": {
          "type": "number"
        }
      },
      "required": [
        "building",
        "terrain"
      ]
    },
    "geometry": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "coordinates",
        "type"
      ]
    }
  },
  "required": [
    "rde_type",
    "represents",
    "uuid",
    "geometry"
  ],
  "additionalProperties": true
}