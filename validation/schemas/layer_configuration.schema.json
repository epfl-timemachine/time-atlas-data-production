{
    "$id": "https://timeatlas.eu/rde/layer_configuration.schema.json",
    "type": "object",
    "properties": {
        "uuid": {
            "type": "string"
        },
        "extent": {
            "type": "array",
            "items": {
                "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
        },
        "zoom_lvl": {
            "type": "array",
            "items": {
                "type": "integer"
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "url": {
                    "type": "string"
                },
                "media_type": {
                    "type": "string"
                }
            },
            "required": [
                "url",
                "media_type"
            ],
            "additionalProperties": true
        }
    },
    "required": [
        "service",
        "uuid",
        "extent",
        "zoom_lvl"
    ],
    "additionalProperties": false
}