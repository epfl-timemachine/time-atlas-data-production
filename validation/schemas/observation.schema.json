{
  "$id": "https://timeatlas.eu/rde/observation.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "dataset": {
      "type": "string"
    },
    "rde_type": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "has_geometries": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "historical_record": {
      "type": "string"
    },
    "part_of_point_of_interest": {
      "type": "string"
    },
    "geometry": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "coordinates",
        "type"
      ]
    }
  },
  "required": [
    "dataset",
    "historical_record",
    "end_time",
    "has_geometries",
    "part_of_point_of_interest",
    "rde_type",
    "start_time",
    "type",
    "id"
  ],
  "additionalProperties":false
}
