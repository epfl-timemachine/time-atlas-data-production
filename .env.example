# Copy this file to .env, fill only the values needed for the current task, and
# pass it at runtime with `docker run --env-file .env ...`. Never bake secrets
# into the image or commit the populated .env file.

# Required only for MapTiler terrain/building-height derivation.
MAPTILER_API_KEY=

# Required only when an agent will import and publish to a TimeAtlas backend.
# The API URL must end in /v1. TIMEATLAS_TOKEN is a personal access token;
# TIMEATLAS_TEAM_ID is the target team's UUID, not another secret token.
TIMEATLAS_API_URL=
TIMEATLAS_TOKEN=
TIMEATLAS_TEAM_ID=

# Optional: required only by utils/s3_bucket_push.py.
S3_RW_KEY=
S3_RW_SECRET=
