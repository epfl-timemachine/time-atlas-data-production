      ]
     },
     "value": {
      "en": [
       "Paul Guhennec segemented the cloudpoints of the building from a general flyover cloud points data acquisition of the city."
      ],
      "fr": [
       "Paul Guhennec a segmenté le nuage de points de l'immeuble à partir d'une acquisition de données de nuages de points en survol général de la ville."
      ],
      "it": [
       "Paul Guhennec ha segmentato il nuvola di punti dell'edificio a partire da un'acquisizione di dati di nuvole di punti in volo generale della città."
      ],
      "de": [
       "Paul Guhennec segmentierte die Punktwolke des Gebäudes aus einer allgemeinen Punktwolken-Datenerfassung der Stadt bei einem Überflug."
      ]
     },
