      ]
     },
     "value": {
      "en": [
       "The textual data from the register was manually transcribed by various researchers."
      ],
      "fr": [
       "Les données textuelles du registre ont été transcrites manuellement par divers chercheurs."
      ],
      "it": [
       "I dati testuali del registro sono stati trascritti manualmente da vari ricercatori."
      ],
      "nl": [
       "De tekstuele gegevens uit het register zijn handmatig getranscribeerd door verschillende onderzoekers."
      ],
      "de": [
       "Die textuellen Daten aus dem Register wurden von verschiedenen Forschern manuell transkribiert."
      ]
     }
    }
